    }

    .schar {
      width: 32px;
      height: 64px;
      margin-right: 1px;
      object-fit: contain;
    }
  }
}

@media screen and (device: watch-square) {
  .wrap {
    height: 100%;
    width: 100%;
    .container {
      border-radius: 0;
      .bg {
        width: 100%;
        height: 100%;
        border-radius: 0;
        object-fit: cover;
      }

      .date-wrap {
        padding-top: 24px;
      }

      .steps-wrap {
        padding-bottom: 12px;
      }
    }
  }
}

