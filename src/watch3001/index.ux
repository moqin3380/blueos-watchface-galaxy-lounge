      width: 100%;
      height: 100%;
      flex-direction: row;
      align-items: flex-start;
      justify-content: flex-start;
      padding-top: 40px;
      padding-left: 110px;
    }

    .time {
      font-size: 56px;
      font-weight: bold;
    }

    .c0 { color: #9ad9ff; }
    .c1 { color: #b9e8c8; }
    .c2 { color: #f4e79e; }
    .c3 { color: #ffde6e; }
    .c4 { color: #ffd028; }

    .steps-wrap {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      flex-direction: row;
      align-items: flex-end;
      justify-content: center;
      padding-bottom: 40px;
    }

    .steps-icon {
      flex-direction: row;
      align-items: flex-end;
      margin-right: 8px;
      margin-bottom: 10px;
    }

    .foot {
      width: 9px;
      height: 17px;
      border-radius: 5px;
    }

    .f1 {
      background-color: #9ad9ff;
      transform: rotate(-14deg);
    }

    .f2 {
      background-color: #ffd028;
      transform: rotate(12deg);
      margin-left: 4px;
    }

    .steps-digit {
      font-size: 44px;
      font-weight: bold;
    }

    .steps-unit {
      font-size: 24px;
      color: #eef4ff;
      opacity: 0.75;
      margin-left: 5px;
      margin-bottom: 8px;
    }
  }
}

@media screen and (device: watch-square) {
  .wrap {
    height: 100%;
    width: 100%;
    .container {
      border-radius: 0;
      .bg {
        width: 100%;
        height: 100%;
        border-radius: 0;
        object-fit: cover;
      }

      .time-wrap {
        padding-top: 12px;
        padding-left: 24px;
      }

      .steps-wrap {
        padding-bottom: 12px;
      }
    }
  }
}

