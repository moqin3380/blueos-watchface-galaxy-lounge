<template>
  <div class="wrap">
    <div class="container">
      <image class="bg" src="{{bgUrl}}" />
      <div class="date-wrap">
        <text class="date">{{dateStr}}</text>
      </div>
      <div class="time-wrap">
        <image class="tdigit" src="{{slotSrc0}}" />
        <image class="tdigit" src="{{slotSrc1}}" />
        <image class="tcolon" src="{{slotSrc2}}" />
        <image class="tdigit" src="{{slotSrc3}}" />
        <image class="tdigit" src="{{slotSrc4}}" />
      </div>
      <div class="steps-wrap">
        <div class="steps-group">
          <div class="steps-icon"></div>
          <div class="steps-col">
            <text class="steps-label">今日步数</text>
            <div class="steps-row">
              <text class="steps-digit s0">{{stepsChars[0]}}</text>
              <text class="steps-digit s1">{{stepsChars[1]}}</text>
              <text class="steps-digit s2">{{stepsChars[2]}}</text>
              <text class="steps-digit s3">{{stepsChars[3]}}</text>
              <text class="steps-digit s4">{{stepsChars[4]}}</text>
              <text class="steps-digit s5">{{stepsChars[5]}}</text>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
const FRAME_COUNT = 50
const FRAME_MS = 100
const STEPS_MS = 10000
const STEPS_DEFAULT = 8000
const WEEK_DAYS = ['日', '一', '二', '三', '四', '五', '六']

export default {
  props: [],
  data() {
    return {
      timerId: -1,
      stepsTimerId: -1,
      frameIdx: 1,
      timeChars: ['0', '0', ':', '0', '0'],
      slotSrc0: '/watch3001/assets/glass/g_0.png',
      slotSrc1: '/watch3001/assets/glass/g_0.png',
      slotSrc2: '/watch3001/assets/glass/g_colon.png',
      slotSrc3: '/watch3001/assets/glass/g_0.png',
      slotSrc4: '/watch3001/assets/glass/g_0.png',
      dateStr: '',
      stepsChars: ['8', '0', '0', '0', '', ''],
      bgUrl: '/watch3001/assets/frames/frame_001.jpg',
    }
  },

  onInit() {
    this.setSteps(STEPS_DEFAULT)
    this.updateTime()
    this.initSteps()
    this.timerId = setInterval(() => {
      this.frameIdx = this.frameIdx >= FRAME_COUNT ? 1 : this.frameIdx + 1
      this.bgUrl = '/watch3001/assets/frames/frame_' + this.pad(this.frameIdx) + '.jpg'
      this.updateTime()
    }, FRAME_MS)
  },

  updateTime() {
    const t = new Date()
    const s = this.pad2(t.getHours()) + ':' + this.pad2(t.getMinutes())
    this.setSlot(0, s.charAt(0))
    this.setSlot(1, s.charAt(1))
    this.setSlot(2, s.charAt(2))
    this.setSlot(3, s.charAt(3))
    this.setSlot(4, s.charAt(4))
    this.dateStr = '周' + WEEK_DAYS[t.getDay()] + '  ' + this.pad2(t.getMonth() + 1) + '.' + this.pad2(t.getDate())
  },

  setSlot(i, ch) {
    const name = ch === ':' ? 'colon' : ch
    const src = '/watch3001/assets/glass/g_' + name + '.png'
    if (this['slotSrc' + i] !== src) {
      this['slotSrc' + i] = src
    }
  },

  initSteps() {
    try {
      const app = typeof this.$app === 'function' ? this.$app() : this.$app
      this._health = app && app.requireFeature ? app.requireFeature('blueos.health.health') : null
    } catch (e) {
      this._health = null
    }
    this.updateSteps()
    this.stepsTimerId = setInterval(() => {
      this.updateSteps()
    }, STEPS_MS)
  },

  updateSteps() {
    if (!this._health || !this._health.getRecentSamples) {
      return
    }
    try {
      this._health.getRecentSamples({
        dataType: ['STEP_COUNT'],
        success: (data) => {
          const v = data && data.data && data.data.value
          if (v !== undefined && v !== null && !isNaN(Number(v))) {
            this.setSteps(Math.round(Number(v)))
          }
        },
      })
    } catch (e) {}
  },

  setSteps(n) {
    const s = '' + n
    const chars = []
    for (let i = 0; i < 6; i++) {
      chars.push(i < s.length ? s.charAt(i) : '')
    }
    this.stepsChars = chars
  },

  onDestroy() {
    clearInterval(this.timerId)
    clearInterval(this.stepsTimerId)
  },

  pad(n) {
    return n < 10 ? '00' + n : n < 100 ? '0' + n : '' + n
  },

  pad2(n) {
    return n < 10 ? '0' + n : '' + n
  },
}
</script>

