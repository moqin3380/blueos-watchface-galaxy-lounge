      font-weight: bold;
      color: #ffffff;
    }
  }
}

@media screen and (device: watch-square) {
  .wrap {
    height: 100%;
    width: 100%;
    .container {
      border-radius: 0;
      .bg {
        width: 100%;
        height: 100%;
        border-radius: 0;
        object-fit: cover;
      }

      .time-wrap {
        padding-top: 12px;
        padding-left: 24px;
      }

      .steps-wrap {
        padding-bottom: 12px;
      }
    }
  }
}

