<template>
  <div class="wrap">
    <div class="container">
      <image class="bg" src="{{bgUrl}}" />
      <div class="time-wrap">
        <text class="time c0">{{timeChars[0]}}</text>
        <text class="time c1">{{timeChars[1]}}</text>
        <text class="time c2">{{timeChars[2]}}</text>
        <text class="time c3">{{timeChars[3]}}</text>
        <text class="time c4">{{timeChars[4]}}</text>
      </div>
      <div class="steps-wrap">
        <div class="steps-icon">
          <div class="foot f1"></div>
          <div class="foot f2"></div>
        </div>
        <text class="steps-digit" for="{{stepsChars}}" style="color: {{$item.color}}">{{$item.ch}}</text>
        <text class="steps-unit">步</text>
      </div>
    </div>
  </div>
</template>

<script>
const FRAME_COUNT = 50
const FRAME_MS = 100
const STEPS_MS = 10000
const GRADIENT_FROM = [0x9a, 0xd9, 0xff]
const GRADIENT_TO = [0xff, 0xd0, 0x28]

export default {
  props: [],
  data() {
    return {
      timerId: -1,
      stepsTimerId: -1,
      frameIdx: 1,
      timeChars: ['0', '0', ':', '0', '0'],
      stepsChars: [{ ch: '0', color: '#cdd4a3' }],
      bgUrl: '/watch3001/assets/frames/frame_001.jpg',
    }
  },

  onInit() {
    this.updateTime()
    this.initSteps()
    this.timerId = setInterval(() => {
      this.frameIdx = this.frameIdx >= FRAME_COUNT ? 1 : this.frameIdx + 1
      this.bgUrl = '/watch3001/assets/frames/frame_' + this.pad(this.frameIdx) + '.jpg'
      this.updateTime()
    }, FRAME_MS)
  },

  updateTime() {
    const t = new Date()
    this.timeChars = (this.pad2(t.getHours()) + ':' + this.pad2(t.getMinutes())).split('')
  },

  initSteps() {
    try {
      const app = typeof this.$app === 'function' ? this.$app() : this.$app
      this._health = app && app.requireFeature ? app.requireFeature('blueos.health.health') : null
    } catch (e) {
      this._health = null
    }
    this.updateSteps()
    this.stepsTimerId = setInterval(() => {
      this.updateSteps()
    }, STEPS_MS)
  },

  updateSteps() {
    if (!this._health || !this._health.getRecentSamples) {
      this.setSteps(0)
      return
    }
    try {
      this._health.getRecentSamples({
        dataType: ['STEP_COUNT'],
        success: (data) => {
          const v = data && data.data && data.data.value
          this.setSteps(Math.round(Number(v)) || 0)
        },
        fail: () => this.setSteps(0),
      })
    } catch (e) {
      this.setSteps(0)
    }
  },

  setSteps(n) {
    const s = '' + n
    const colors = this.gradientColors(s.length)
    this.stepsChars = s.split('').map((ch, i) => ({ ch: ch, color: colors[i] }))
  },

  gradientColors(n) {
    const colors = []
    for (let i = 0; i < n; i++) {
      const t = n === 1 ? 0.5 : i / (n - 1)
      const r = Math.round(GRADIENT_FROM[0] + (GRADIENT_TO[0] - GRADIENT_FROM[0]) * t)
      const g = Math.round(GRADIENT_FROM[1] + (GRADIENT_TO[1] - GRADIENT_FROM[1]) * t)
      const b = Math.round(GRADIENT_FROM[2] + (GRADIENT_TO[2] - GRADIENT_FROM[2]) * t)
      colors.push('rgb(' + r + ', ' + g + ', ' + b + ')')
    }
    return colors
  },

  onDestroy() {
    clearInterval(this.timerId)
    clearInterval(this.stepsTimerId)
  },

  pad(n) {
    return n < 10 ? '00' + n : n < 100 ? '0' + n : '' + n
  },

  pad2(n) {
    return n < 10 ? '0' + n : '' + n
  },
}
</script>

<style lang="less">
.wrap {
  height: 466px;
  width: 466px;
  .container {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-image: url("./assets/wallpaper.jpg");
    background-size: cover;

    .bg {
      width: 466px;
      height: 466px;
      border-radius: 50%;
      object-fit: cover;
    }

    .time-wrap {
      position: absolute;
      top: 0;
