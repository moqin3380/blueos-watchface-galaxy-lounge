<template>
  <div class="wrap">
    <div class="container">
      <image class="bg" src="{{bgUrl}}" />
      <div class="date-wrap">
        <image class="dchar dcn" src="/watch3001/assets/glass/blue/c_zhou.png" />
        <image class="dchar dcn" src="{{dateSrc1}}" />
        <div class="dgap"></div>
        <image class="dchar ddg" src="{{dateSrc2}}" />
        <image class="dchar ddg" src="{{dateSrc3}}" />
        <div class="dchar ddot"></div>
        <image class="dchar ddg" src="{{dateSrc4}}" />
        <image class="dchar ddg" src="{{dateSrc5}}" />
      </div>
      <div class="time-wrap">
        <image class="tdigit" src="{{slotSrc0}}" />
        <image class="tdigit" src="{{slotSrc1}}" />
        <div class="tcolon"></div>
        <image class="tdigit" src="{{slotSrc3}}" />
        <image class="tdigit" src="{{slotSrc4}}" />
      </div>
      <div class="steps-wrap">
        <div class="steps-group">
          <div class="steps-icon"></div>
        <div class="steps-col">
          <div class="steps-label">
            <image class="lchar" src="/watch3001/assets/glass/gold/c_jin.png" />
            <image class="lchar" src="/watch3001/assets/glass/gold/c_ri.png" />
            <image class="lchar" src="/watch3001/assets/glass/gold/c_bu.png" />
            <image class="lchar" src="/watch3001/assets/glass/gold/c_shu.png" />
          </div>
          <div class="steps-row">
            <image class="schar" if="{{stepsShow0}}" src="{{stepsImg0}}" />
            <image class="schar" if="{{stepsShow1}}" src="{{stepsImg1}}" />
            <image class="schar" if="{{stepsShow2}}" src="{{stepsImg2}}" />
            <image class="schar" if="{{stepsShow3}}" src="{{stepsImg3}}" />
            <image class="schar" if="{{stepsShow4}}" src="{{stepsImg4}}" />
            <image class="schar" if="{{stepsShow5}}" src="{{stepsImg5}}" />
          </div>
        </div>
        </div>
      </div>
    </div>
    <div class="aod-wrap" if="{{aodOn}}">
      <div class="aod-time">
        <image class="atdigit" src="{{aodT0}}" />
        <image class="atdigit" src="{{aodT1}}" />
        <image class="atcolon" src="{{aodT2}}" />
        <image class="atdigit" src="{{aodT3}}" />
        <image class="atdigit" src="{{aodT4}}" />
      </div>
      <div class="aod-water-box">
        <div class="awf aw1" if="{{aodFrame === 1}}"></div>
        <div class="awf aw2" if="{{aodFrame === 2}}"></div>
        <div class="awf aw3" if="{{aodFrame === 3}}"></div>
        <div class="awf aw4" if="{{aodFrame === 4}}"></div>
        <div class="awf aw5" if="{{aodFrame === 5}}"></div>
        <div class="awf aw6" if="{{aodFrame === 6}}"></div>
        <div class="awf aw7" if="{{aodFrame === 7}}"></div>
        <div class="awf aw8" if="{{aodFrame === 8}}"></div>
        <div class="awf aw9" if="{{aodFrame === 9}}"></div>
        <div class="awf aw10" if="{{aodFrame === 10}}"></div>
        <div class="awf aw11" if="{{aodFrame === 11}}"></div>
        <div class="awf aw12" if="{{aodFrame === 12}}"></div>
      </div>
    </div>
  </div>
</template>

<script>
const FRAME_COUNT = 50
const FRAME_MS = 100
const STEPS_MS = 10000
const STEPS_DEFAULT = 8000
const AOD_FRAMES = 12
const AOD_MS = 160
const WEEK_FILES = ['c_ri', 'c_yi', 'c_er', 'c_san', 'c_si', 'c_wu', 'c_liu']

export default {
  props: [],
  data() {
    return {
      timerId: -1,
      stepsTimerId: -1,
      aodTimerId: -1,
      aodOn: true,
      aodFrame: 1,
      aodT0: '/watch3001/assets/aod/t_0.png',
      aodT1: '/watch3001/assets/aod/t_0.png',
      aodT2: '/watch3001/assets/aod/t_colon.png',
      aodT3: '/watch3001/assets/aod/t_0.png',
      aodT4: '/watch3001/assets/aod/t_0.png',
      frameIdx: 1,
      slotSrc0: '/watch3001/assets/glass/blue/g_0.png',
      slotSrc1: '/watch3001/assets/glass/mint/g_0.png',
      slotSrc3: '/watch3001/assets/glass/lgold/g_0.png',
      slotSrc4: '/watch3001/assets/glass/gold/g_0.png',
      dateSrc1: '/watch3001/assets/glass/blue/c_ri.png',
      dateSrc2: '/watch3001/assets/glass/blue/g_1.png',
      dateSrc3: '/watch3001/assets/glass/blue/g_0.png',
      dateSrc4: '/watch3001/assets/glass/blue/g_0.png',
      dateSrc5: '/watch3001/assets/glass/blue/g_4.png',
      stepsImg0: '/watch3001/assets/glass/gold/g_8.png',
      stepsImg1: '/watch3001/assets/glass/gold/g_0.png',
      stepsImg2: '/watch3001/assets/glass/gold/g_0.png',
      stepsImg3: '/watch3001/assets/glass/gold/g_0.png',
      stepsImg4: '/watch3001/assets/glass/none.png',
      stepsImg5: '/watch3001/assets/glass/none.png',
      stepsShow0: true,
      stepsShow1: true,
      stepsShow2: true,
      stepsShow3: true,
      stepsShow4: false,
      stepsShow5: false,
      bgUrl: '/watch3001/assets/frames/frame_001.jpg',
    }
  },

  onInit() {
    this.setSteps(STEPS_DEFAULT)
    this.updateTime()
    this.initSteps()
    this.initAod()
    if (this.aodOn) {
      this.enterAod()
    }
    this.timerId = setInterval(() => {
      this.frameIdx = this.frameIdx >= FRAME_COUNT ? 1 : this.frameIdx + 1
      this.bgUrl = '/watch3001/assets/frames/frame_' + this.pad(this.frameIdx) + '.jpg'
      this.updateTime()
    }, FRAME_MS)
  },

  updateTime() {
    const t = new Date()
    const s = this.pad2(t.getHours()) + ':' + this.pad2(t.getMinutes())
    this.setSlot(0, s.charAt(0))
    this.setSlot(1, s.charAt(1))
    this.setSlot(3, s.charAt(3))
    this.setSlot(4, s.charAt(4))
    this.setDate(t)
  },

  setDate(t) {
    this.setDateChar(1, WEEK_FILES[t.getDay()])
    const mm = this.pad2(t.getMonth() + 1)
    const dd = this.pad2(t.getDate())
    this.setDateChar(2, 'g_' + mm.charAt(0))
    this.setDateChar(3, 'g_' + mm.charAt(1))
    this.setDateChar(4, 'g_' + dd.charAt(0))
    this.setDateChar(5, 'g_' + dd.charAt(1))
  },

  setDateChar(i, name) {
    const src = '/watch3001/assets/glass/blue/' + name + '.png'
    if (this['dateSrc' + i] !== src) {
      this['dateSrc' + i] = src
    }
  },

  setSlot(i, ch) {
    const dirs = { 0: 'blue', 1: 'mint', 3: 'lgold', 4: 'gold' }
    const src = '/watch3001/assets/glass/' + dirs[i] + '/g_' + ch + '.png'
    if (this['slotSrc' + i] !== src) {
      this['slotSrc' + i] = src
    }
  },

  initSteps() {
    try {
      const app = typeof this.$app === 'function' ? this.$app() : this.$app
      this._health = app && app.requireFeature ? app.requireFeature('blueos.health.health') : null
    } catch (e) {
      this._health = null
    }
    this.updateSteps()
    this.stepsTimerId = setInterval(() => {
      this.updateSteps()
    }, STEPS_MS)
  },

  updateSteps() {
    if (!this._health || !this._health.getRecentSamples) {
      return
    }
    try {
      this._health.getRecentSamples({
        dataType: ['STEP_COUNT'],
        success: (data) => {
          const v = data && data.data && data.data.value
          if (v !== undefined && v !== null && !isNaN(Number(v))) {
            this.setSteps(Math.round(Number(v)))
          }
        },
      })
    } catch (e) {}
  },

  setSteps(n) {
    const s = '' + n
    for (let i = 0; i < 6; i++) {
      const has = i < s.length
      this['stepsShow' + i] = has
      if (has) {
        const src = '/watch3001/assets/glass/gold/g_' + s.charAt(i) + '.png'
        if (this['stepsImg' + i] !== src) {
          this['stepsImg' + i] = src
        }
      }
    }
  },

  initAod() {
    try {
      const app = typeof this.$app === 'function' ? this.$app() : this.$app
      this._events = app && app.requireFeature ? app.requireFeature('blueos.app.event.eventManager') : null
    } catch (e) {
      this._events = null
    }
    if (this._events && this._events.subscribe) {
      try {
        this._events.subscribe({ eventName: 'usual.event.SCREEN_AOD', callback: () => this.enterAod() })
        this._events.subscribe({ eventName: 'usual.event.SCREEN_ON', callback: () => this.exitAod() })
        this._events.subscribe({ eventName: 'usual.event.SCREEN_OFF', callback: () => this.exitAod() })
      } catch (e) {
        this._events = null
      }
    }
  },

  enterAod() {
    this.aodOn = true
    this.aodFrame = 1
    this.refreshAodTime()
    if (this.aodTimerId === -1) {
      this.aodTimerId = setInterval(() => {
        this.aodFrame = this.aodFrame >= AOD_FRAMES ? 1 : this.aodFrame + 1
        this.refreshAodTime()
      }, AOD_MS)
    }
  },

  refreshAodTime() {
    const t = new Date()
    const s = this.pad2(t.getHours()) + ':' + this.pad2(t.getMinutes())
    this.setAodT(0, s.charAt(0))
    this.setAodT(1, s.charAt(1))
    this.setAodT(2, s.charAt(2))
    this.setAodT(3, s.charAt(3))
    this.setAodT(4, s.charAt(4))
  },

  setAodT(i, ch) {
    const src = '/watch3001/assets/aod/t_' + (ch === ':' ? 'colon' : ch) + '.png'
    if (this['aodT' + i] !== src) {
      this['aodT' + i] = src
    }
  },

  exitAod() {
    this.aodOn = false
    if (this.aodTimerId !== -1) {
      clearInterval(this.aodTimerId)
      this.aodTimerId = -1
    }
  },

  onDestroy() {
    clearInterval(this.timerId)
    clearInterval(this.stepsTimerId)
    clearInterval(this.aodTimerId)
  },

  pad(n) {
    return n < 10 ? '00' + n : n < 100 ? '0' + n : '' + n
  },

  pad2(n) {
    return n < 10 ? '0' + n : '' + n
  },
}
</script>

