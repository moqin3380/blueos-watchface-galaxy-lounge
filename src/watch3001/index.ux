    }

    .steps-label {
      font-size: 26px;
      color: #b9e8c8;
      margin-bottom: 6px;
    }

    .steps-row {
      flex-direction: row;
    }

    .steps-digit {
      font-size: 48px;
      font-weight: bold;
    }

    .s0 { color: #9ad9ff; }
    .s1 { color: #b9e8c8; }
    .s2 { color: #f4e79e; }
    .s3 { color: #ffd028; }
    .s4 { color: #ffd028; }
    .s5 { color: #ffd028; }
  }
}

@media screen and (device: watch-square) {
  .wrap {
    height: 100%;
    width: 100%;
    .container {
      border-radius: 0;
      .bg {
        width: 100%;
        height: 100%;
        border-radius: 0;
        object-fit: cover;
      }

      .date-wrap {
        padding-top: 24px;
      }

      .steps-wrap {
        padding-bottom: 12px;
      }
    }
  }
}

