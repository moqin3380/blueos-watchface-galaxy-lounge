      transform: rotate(10deg);
    }

    .wk-leg-f {
      position: absolute;
      background-color: #ffffff;
      width: 9px;
      height: 20px;
      border-radius: 4px;
      left: 21px;
      top: 33px;
      transform: rotate(30deg);
    }

    .wk-leg-b {
      position: absolute;
      background-color: #ffffff;
      width: 9px;
      height: 18px;
      border-radius: 4px;
      left: 10px;
