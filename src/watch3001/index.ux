<template>
  <div class="wrap">
    <div class="container">
      <image class="bg" src="{{bgUrl}}" />
      <div class="time-wrap">
        <text class="time c0">{{timeChars[0]}}</text>
        <text class="time c1">{{timeChars[1]}}</text>
        <text class="time c2">{{timeChars[2]}}</text>
        <text class="time c3">{{timeChars[3]}}</text>
        <text class="time c4">{{timeChars[4]}}</text>
      </div>
      <div class="steps-wrap">
        <div class="walker">
          <div class="wk-head"></div>
          <div class="wk-body"></div>
          <div class="wk-leg-f"></div>
          <div class="wk-leg-b"></div>
        </div>
        <text class="steps-digit">{{stepsText}}</text>
      </div>
    </div>
  </div>
</template>

<script>
const FRAME_COUNT = 50
const FRAME_MS = 100
const STEPS_MS = 10000

export default {
  props: [],
  data() {
    return {
      timerId: -1,
      stepsTimerId: -1,
      frameIdx: 1,
      timeChars: ['0', '0', ':', '0', '0'],
      stepsText: '0',
      bgUrl: '/watch3001/assets/frames/frame_001.jpg',
    }
  },

  onInit() {
    this.updateTime()
    this.initSteps()
    this.timerId = setInterval(() => {
      this.frameIdx = this.frameIdx >= FRAME_COUNT ? 1 : this.frameIdx + 1
      this.bgUrl = '/watch3001/assets/frames/frame_' + this.pad(this.frameIdx) + '.jpg'
      this.updateTime()
    }, FRAME_MS)
  },

  updateTime() {
    const t = new Date()
    this.timeChars = (this.pad2(t.getHours()) + ':' + this.pad2(t.getMinutes())).split('')
  },

  initSteps() {
    try {
      const app = typeof this.$app === 'function' ? this.$app() : this.$app
      this._health = app && app.requireFeature ? app.requireFeature('blueos.health.health') : null
    } catch (e) {
      this._health = null
    }
    this.updateSteps()
    this.stepsTimerId = setInterval(() => {
      this.updateSteps()
    }, STEPS_MS)
  },

  updateSteps() {
    if (!this._health || !this._health.getRecentSamples) {
      this.setSteps(0)
      return
    }
    try {
      this._health.getRecentSamples({
        dataType: ['STEP_COUNT'],
        success: (data) => {
          const v = data && data.data && data.data.value
          this.setSteps(Math.round(Number(v)) || 0)
        },
        fail: () => this.setSteps(0),
      })
    } catch (e) {
      this.setSteps(0)
    }
  },

  setSteps(n) {
    this.stepsText = '' + n
  },

  onDestroy() {
    clearInterval(this.timerId)
    clearInterval(this.stepsTimerId)
  },

  pad(n) {
    return n < 10 ? '00' + n : n < 100 ? '0' + n : '' + n
  },

  pad2(n) {
    return n < 10 ? '0' + n : '' + n
  },
}
</script>

