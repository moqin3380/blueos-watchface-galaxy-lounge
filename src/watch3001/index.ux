    .steps-wrap {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      flex-direction: row;
      align-items: flex-end;
      justify-content: center;
      padding-bottom: 40px;
    }

    .walker {
      position: relative;
